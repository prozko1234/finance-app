# ---------- .NET ----------
bin/
obj/
*.user
*.suo
.vs/
[Dd]ebug/
[Rr]elease/
project.assets.json
*.nupkg

# ---------- SQLite (local dev data) ----------
*.db
*.db-shm
*.db-wal
*.sqlite

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---------- Secrets / env ----------
.env
.env.*
!.env.example
secrets.json
# Local-only settings overrides (never commit real connection strings / keys)
appsettings.Local.json
appsettings.*.Local.json
**/appsettings.Production.json
*.pfx
*.p12

# ---------- OS / editor ----------
.DS_Store
.idea/
*.swp

# Capacitor iOS — the project is committed, its build output is not.
frontend/ios/App/build/
frontend/ios/App/DerivedData/
frontend/ios/App/App/public/
frontend/ios/App/App/capacitor.config.json
frontend/ios/App/.swiftpm/

# Built web bundle for live updates — regenerated by scripts/make-bundle.sh
frontend/bundle/
# wwwroot holds the SPA in the image; locally it stays empty but must exist (.gitkeep).
backend/Api/wwwroot/*
!backend/Api/wwwroot/.gitkeep
