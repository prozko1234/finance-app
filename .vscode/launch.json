{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend (Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/Api/bin/Debug/net10.0/Api.dll",
      "cwd": "${workspaceFolder}/backend/Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5099",
        "DOTNET_ROOT": "/opt/homebrew/opt/dotnet/libexec",
        "PATH": "/opt/homebrew/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": ["run", "dev"],
      "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run all (backend + frontend)",
      "configurations": ["Debug backend (Api)", "Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
